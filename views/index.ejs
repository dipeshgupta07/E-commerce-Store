<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dilip Bakery</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&display=swap" rel="stylesheet">
</head>
<body>

  <!-- Header -->
<header class="banner">
  <div class="logo">
    <img src="/images/logo.png" alt="Logo">
    <h1>Dilip Bakery</h1>
  </div>
  <div class="hamburger" id="hamburger">&#9776;</div>
  <nav class="nav-links" id="nav-links">
    <a href="/about">About Us</a>
    <a href="/store">Come to Store</a>
    <a href="/contact">Contact Us</a>
  </nav>
</header>


  <!-- 👇 Slider Section -->
  <div class="slider">
    <div class="slides">
      <div class="slide"><img src="/images/offer1.png" alt="Offer 1"></div>
      <div class="slide"><img src="/images/offer2.png" alt="Offer 2"></div>
      <div class="slide"><img src="/images/offer1.png" alt="Offer 3"></div>
      <div class="slide"><img src="/images/offer2.png" alt="Offer 4"></div>
    </div>
  </div>



<!-- Buy With Flavours Section -->
<section class="flavour-section">
  <h2>Buy With Flavours</h2>
  <div class="flavour-grid">
    <a href="/flavours/chocolate"><div class="flavour-card">
      <img src="/images/flavours/chocolate.png" alt="Chocolate">
      <p>Chocolate</p>
    </div>
  </a>

  <a href="/flavours/vanilla">
      <div class="flavour-card">
      <img src="/images/flavours/vanilla.png" alt="Vanilla">
      <p>Vanilla</p>
    </div>
    </a>
    <div class="flavour-card">
      <img src="/images/flavours/strawberry.png" alt="Strawberry">
      <p>Strawberry</p>
    </div>
    <div class="flavour-card">
      <img src="/images/flavours/butterscotch.png" alt="Butterscotch">
      <p>Butterscotch</p>
    </div>


    <div class="flavour-card">
      <img src="/images/flavours/pineapple.png" alt="Butterscotch">
      <p>Pineapple</p>
    </div>
  </div>
</section>



<!-- Latest Designs Section -->
<section class="latest-designs">
  <h2>Latest Designs</h2>
  <div class="designs-grid">
    <div class="design-card">
      <img src="/images/designs/cake1.png" alt="Cake Design 1">
      <div class="design-info">
        <p>Chocolate Layer Cake</p>
        <span>₹799</span>
      </div>
    </div>
    <div class="design-card">
      <img src="/images/designs/cake2.png" alt="Cake Design 2">
      <div class="design-info">
        <p>Vanilla Rose Cake</p>
        <span>₹699</span>
      </div>
    </div>
    <div class="design-card">
      <img src="/images/designs/cake3.png" alt="Cake Design 3">
      <div class="design-info">
        <p>Oreo Drip Cake</p>
        <span>₹849</span>
      </div>
    </div>
  </div>
</section>


  
  










<!-- Thank You Message -->
<section class="thank-you">
  <h2>Thank you for choosing Us</h2>
  <p>— with Love, <span>Dilip Bakery</span> 🧁</p>
</section>

<!-- About Us Section -->
<section class="about-us">
  <h2>About Us</h2>
  <p>
    At Dilip Bakery, we bring sweetness to your celebrations with our hand-crafted cakes, freshly baked with love and quality ingredients. Whether it’s birthdays, anniversaries, or just because — our cakes are made to make memories.
  </p>
  <p>
    Established in 2020, we've become a local favorite by delivering not just treats, but happiness in every bite.
  </p>
</section>


  <script src="/js/app.js"></script>
</body>
</html>
